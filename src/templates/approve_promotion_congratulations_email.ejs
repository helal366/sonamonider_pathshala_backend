 <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Congratulations on Your Promotion - SONAMONIDER PATHSHALA</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #eef2f6;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #eef2f6; padding: 40px 12px"
    >
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 5px 18px rgba(15, 23, 42, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: #153e75;
                  padding: 35px 25px;
                  border-bottom: 4px solid #c9972b;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 26px;
                    line-height: 34px;
                    letter-spacing: 1px;
                  "
                >
                  SONAMONIDER PATHSHALA
                </h1>
                <p
                  style="
                    margin: 10px 0 0;
                    color: #dbeafe;
                    font-size: 14px;
                    letter-spacing: 1px;
                  "
                >
                  RECOGNIZING GROWTH AND ACHIEVEMENT
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px">
                <h2
                  style="
                    margin: 0 0 22px;
                    color: #153e75;
                    font-size: 25px;
                    line-height: 34px;
                    text-align: center;
                  "
                >
                  Congratulations on Your Promotion!
                </h2>

                <p
                  style="
                    margin: 0 0 18px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  Dear <strong><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 22px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  We are pleased to inform you that your promotion has been
                  officially approved by the management of
                  <strong>SONAMONIDER PATHSHALA</strong>.
                </p>

                <!-- New Position Highlight -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 25px 0"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background: #f0fdf4;
                        border: 1px solid #bbf7d0;
                        border-radius: 10px;
                        padding: 25px 20px;
                      "
                    >
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #64748b;
                          font-size: 13px;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: 1.5px;
                        "
                      >
                        Your New Position
                      </p>

                      <h3
                        style="
                          margin: 0;
                          color: #166534;
                          font-size: 24px;
                          line-height: 33px;
                        "
                      >
                        <%= presentPosition %>
                      </h3>
                    </td>
                  </tr>
                </table>

                <!-- Position and Role Details -->
                <h3
                  style="
                    margin: 30px 0 15px;
                    color: #153e75;
                    font-size: 18px;
                  "
                >
                  Your Updated Employment Details
                </h3>

                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border: 1px solid #e2e8f0;
                    border-radius: 8px;
                  "
                >
                  <tr>
                    <td
                      style="
                        padding: 14px;
                        color: #64748b;
                        font-size: 14px;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Previous Position
                    </td>
                    <td
                      align="right"
                      style="
                        padding: 14px;
                        color: #334155;
                        font-size: 14px;
                        font-weight: 600;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      <%= previousPosition %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        padding: 14px;
                        color: #64748b;
                        font-size: 14px;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Previous Role
                    </td>
                    <td
                      align="right"
                      style="
                        padding: 14px;
                        color: #334155;
                        font-size: 14px;
                        font-weight: 600;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      <%= previousRole %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        padding: 14px;
                        color: #64748b;
                        font-size: 14px;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Present Position
                    </td>
                    <td
                      align="right"
                      style="
                        padding: 14px;
                        color: #166534;
                        font-size: 14px;
                        font-weight: 700;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      <%= presentPosition %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        padding: 14px;
                        color: #64748b;
                        font-size: 14px;
                      "
                    >
                      Present Role
                    </td>
                    <td
                      align="right"
                      style="
                        padding: 14px;
                        color: #334155;
                        font-size: 14px;
                        font-weight: 600;
                      "
                    >
                      <%= presentRole %>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 25px 0 16px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  This promotion reflects your professional growth and the
                  trust placed in you by the management. We appreciate your
                  contributions and look forward to your continued dedication
                  and success in your new position.
                </p>

                <p
                  style="
                    margin: 0;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  Congratulations once again, and best wishes for continued
                  success in your career with SONAMONIDER PATHSHALA.
                </p>

                <p
                  style="
                    margin: 28px 0 0;
                    color: #334155;
                    font-size: 15px;
                    line-height: 25px;
                  "
                >
                  Best regards,<br />
                  <strong>Management</strong><br />
                  SONAMONIDER PATHSHALA
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background: #f8fafc;
                  padding: 24px;
                  border-top: 1px solid #e8edf2;
                "
              >
                <p
                  style="
                    margin: 0;
                    color: #64748b;
                    font-size: 13px;
                    line-height: 21px;
                  "
                >
                  &copy; <%= year %> SONAMONIDER PATHSHALA. All rights reserved.
                </p>

                <p
                  style="
                    margin: 8px 0 0;
                    color: #94a3b8;
                    font-size: 12px;
                    line-height: 19px;
                  "
                >
                  This is an automated notification regarding your promotion
                  approval. Please do not reply directly to this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>