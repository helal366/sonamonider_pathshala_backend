<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - SONAMONIDER PATHSHALA</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #eef2f6;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #eef2f6; padding: 40px 12px"
    >
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 10px;
              overflow: hidden;
              box-shadow: 0 5px 18px rgba(15, 23, 42, 0.08);
            "
          >
            <tr>
              <td
                align="center"
                style="
                  background: #153e75;
                  padding: 32px 30px;
                  border-bottom: 4px solid #c9972b;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 28px;
                    letter-spacing: 1px;
                  "
                >
                  SONAMONIDER PATHSHALA
                </h1>
              </td>
            </tr>
            <tr>
              <td style="padding: 40px">
                <h2 style="margin: 0 0 22px; color: #1d7650; font-size: 23px">
                  Password reset successful
                </h2>
                <p
                  style="
                    margin: 0 0 16px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 26px;
                  "
                >
                  Hello <strong><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0;
                    color: #334155;
                    font-size: 16px;
                    line-height: 26px;
                  "
                >
                  Your SONAMONIDER PATHSHALA password has been reset
                  successfully. Use the new password below to sign in.
                </p>
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 26px 0"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background: #f0fdf4;
                        border: 1px solid #bbf7d0;
                        border-radius: 8px;
                        padding: 22px;
                      "
                    >
                      <p
                        style="
                          margin: 0 0 8px;
                          color: #64748b;
                          font-size: 13px;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                        "
                      >
                        New password
                      </p>
                      <div
                        style="
                          color: #153e75;
                          font-family: Consolas, Monaco, monospace;
                          font-size: 28px;
                          font-weight: 700;
                          letter-spacing: 4px;
                          word-break: break-word;
                        "
                      >
                        <%= password %>
                      </div>
                    </td>
                  </tr>
                </table>
                <p
                  style="
                    margin: 0;
                    color: #334155;
                    font-size: 15px;
                    line-height: 24px;
                  "
                >
                  Please change this password after signing in. Never share your
                  password with anyone.
                </p>
              </td>
            </tr>
            <tr>
              <td
                align="center"
                style="
                  background: #f8fafc;
                  padding: 24px;
                  border-top: 1px solid #e8edf2;
                "
              >
                <p style="margin: 0; color: #64748b; font-size: 14px">
                  &copy; <%= year %> SONAMONIDER PATHSHALA. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
