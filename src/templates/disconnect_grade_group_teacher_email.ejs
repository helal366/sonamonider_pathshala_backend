<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= className.toLowerCase().includes("grade") ? "Grade Teacher" : "Group Teacher" %> Assignment Removal - SONAMONIDER PATHSHALA</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #eef2f6;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #eef2f6; padding: 40px 12px"
    >
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 5px 18px rgba(15, 23, 42, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: #153e75;
                  padding: 32px 25px;
                  border-bottom: 4px solid #c9972b;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 26px;
                    line-height: 34px;
                    letter-spacing: 1px;
                  "
                >
                  SONAMONIDER PATHSHALA
                </h1>

                <p
                  style="
                    margin: 10px 0 0;
                    color: #dbeafe;
                    font-size: 14px;
                    letter-spacing: 1px;
                  "
                >
                  OFFICIAL STAFF NOTIFICATION
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px">
                <h2
                  style="
                    margin: 0 0 24px;
                    color: #153e75;
                    font-size: 23px;
                    line-height: 32px;
                  "
                >
                  <%= className.toLowerCase().includes("grade") ? "Grade Teacher" : "Group Teacher" %>
                  Assignment Removal
                </h2>

                <p
                  style="
                    margin: 0 0 18px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  Dear <strong><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 22px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  This email is to officially inform you that the management
                  of <strong>SONAMONIDER PATHSHALA</strong> has removed your
                  assignment as
                  <strong>
                    <%= className.toLowerCase().includes("grade") ? "Grade Teacher" : "Group Teacher" %>
                  </strong>
                  for the following class.
                </p>

                <!-- Assignment Details -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    margin: 24px 0;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    background: #f8fafc;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 24px 20px">
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #64748b;
                          font-size: 13px;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: 1.5px;
                        "
                      >
                        Previously Assigned Class
                      </p>

                      <h3
                        style="
                          margin: 0;
                          color: #153e75;
                          font-size: 26px;
                          line-height: 35px;
                        "
                      >
                        <%= className %>
                      </h3>

                      <p
                        style="
                          margin: 12px 0 0;
                          color: #b45309;
                          font-size: 14px;
                          font-weight: 600;
                          line-height: 22px;
                        "
                      >
                        Assignment Status: Removed
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 18px;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  From this point forward, you are no longer assigned as the
                  <%= className.toLowerCase().includes("grade") ? "Grade Teacher" : "Group Teacher" %>
                  for this class. Please coordinate with the Academic Incharge
                  regarding any necessary handover of class-related
                  responsibilities and records.
                </p>

                <p
                  style="
                    margin: 0;
                    color: #334155;
                    font-size: 16px;
                    line-height: 27px;
                  "
                >
                  This notification concerns only the above class assignment.
                  Please contact the school administration if you require
                  clarification.
                </p>

                <p
                  style="
                    margin: 28px 0 0;
                    color: #334155;
                    font-size: 15px;
                    line-height: 25px;
                  "
                >
                  Regards,<br />
                  <strong>School Management</strong><br />
                  SONAMONIDER PATHSHALA
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background: #f8fafc;
                  padding: 24px;
                  border-top: 1px solid #e8edf2;
                "
              >
                <p
                  style="
                    margin: 0;
                    color: #64748b;
                    font-size: 13px;
                    line-height: 21px;
                  "
                >
                  &copy; <%= year %> SONAMONIDER PATHSHALA. All rights reserved.
                </p>

                <p
                  style="
                    margin: 8px 0 0;
                    color: #94a3b8;
                    font-size: 12px;
                    line-height: 19px;
                  "
                >
                  This is an automated official notification. Please do not
                  reply directly to this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>