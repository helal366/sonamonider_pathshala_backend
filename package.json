{
  "name": "model_academy",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "imports": {
    "#db-client": {
      "default": "./src/generated/prisma/client.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "shx rm -rf dist && pnpm prisma generate && tsup",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "vercel-build": "pnpm prisma generate && tsup",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "pnpm exec tsx src/utils/runSeed.ts",
    "db:push": "prisma db push --force-reset",
    "db:reset-hard": "rimraf prisma/migrations && prisma db push --force-reset && prisma migrate reset --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "shx": "^0.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "ms": "^2.1.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "redis": "^6.2.1",
    "vercel": "^59.16.0",
    "zod": "^4.6.2"
  }
}
