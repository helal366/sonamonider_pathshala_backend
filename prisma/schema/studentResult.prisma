model StudentResult {
  id String @id @default(uuid())

  student_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  monthly_exam_mark_id String
  monthly_exam_mark monthlyExamMark @relation(fields: [monthly_exam_mark_id], references: [id])

  created_by_id String?
  created_by    User?   @relation("student_result_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("student_result_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("student_results")
}
