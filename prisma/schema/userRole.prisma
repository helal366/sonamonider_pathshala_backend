model UserRole {
  id        String @id @default(uuid())
  role_name String @unique

  current_management_staffs ManagementStaff[] @relation("management_current_role")
  positions                 UserPosition[]    @relation("role_position_relation")
  user                      User[]            @relation("user_role_relation")
  management_staff_roles    ManagementStaff[] @relation("roles_managements")

  created_by_id String?
  created_by    ManagementStaff? @relation("role_created_by", fields: [created_by_id], references: [id])
  updated_by_id String?
  updated_by    ManagementStaff? @relation("role_updated_by", fields: [updated_by_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("user_roles")
}
