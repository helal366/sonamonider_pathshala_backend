model MotherDetails {
  id                        String           @id @default(uuid())
  mother_name               String
  nid_no                    String?
  occupation                String?
  job_title                 String?
  educational_qualification EducationDegree?
  monthly_income            String?
  user                      User[]           @relation("user_mother_details")

  mobile_no_1 String?
  mobile_no_2 String?
  mobile_no_3 String?

  created_by_id String?
  created_by    User?           @relation("mother_details_created_by", fields: [created_by_id], references: [id])
  updated_by_id String?
  updated_by    User?           @relation("mother_details_updated_by", fields: [updated_by_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("mother_details")
}
