model GoverningBody {
  id String @id @default(uuid())

  academic_result AcademicResult? @relation(name: "governing_body_academic_result")

  user_id           String @unique
  user_primary_data User   @relation("governing_body_profile", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  promotion_history  PromotionHistory[]
  promotion_requests PromotionRequest[]

  current_position_id String?
  current_position    UserPosition? @relation("governing_bodies_current_position", fields: [current_position_id], references: [id])

  current_role Role?

  created_by_id String?
  created_by    User?   @relation("governing_bodies_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("governing_bodies_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("governing_bodies")
}
