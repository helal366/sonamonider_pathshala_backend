model UserPosition {
  id            String @id @default(uuid())
  position_name String @unique

  user                      User[]            @relation("user_position_relation")
  current_management_staffs ManagementStaff[] @relation("management_current_position")
  current_academic_staffs   AcademicStaff[]   @relation("academic_current_position")

  promotion_history              PromotionHistory[]
  promotion_request_old_position PromotionRequest[] @relation("promotion_request_old_position")
  promotion_request_new_position PromotionRequest[] @relation("promotion_request_new_position")

  created_by_id String?
  created_by    User?   @relation("user_position_created_by", fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updated_by_id String?
  updated_by    User?   @relation("user_position_updated_by", fields: [updated_by_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("user_positions")
}