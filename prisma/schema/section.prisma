model Section{
    id String @id @default(uuid())
    section_name String @unique

    created_by_id String?
    created_by    User?   @relation("section_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

    updated_by_id String?
    updated_by    User?   @relation("section_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

    created_at DateTime  @default(now())
    updated_at DateTime? @updatedAt
}