model ArabicPeriod {
  id                 String @id @default(uuid())
  arabic_period_name String @unique

  start_time String //example: 6:00 AM
  end_time   String //example: 8:00 AM

  class_routines ClassRoutine[]
  arabic_period_class_histries ArabicPeriodClassHistory[]

  created_by_id String?
  created_by    User?   @relation("arabic_period_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("arabic_period_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("arabic_periods")
}

model ArabicSubject {
  id                  String         @id @default(uuid())
  arabic_subject_name String         @unique
  class_routines      ClassRoutine[]
  arabic_subject_class_history ArabicSubjectClassHistory[]

  created_by_id String?
  created_by    User?   @relation("arabic_subject_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("arabic_subject_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("arabic_subjects")
}

model ArabicSubjectClassHistory {
  id String @id @default(uuid())
  class_history_id String
  class_history ClassHistory @relation(fields: [class_history_id], references: [id])
  arabic_subject_id String
  arabic_subject ArabicSubject @relation(fields: [arabic_subject_id], references: [id])
  created_at DateTime @default(now())
  @@unique([class_history_id, arabic_subject_id])
  @@map("arabic_subject_class_histories")
}

model ArabicPeriodClassHistory {
  id String @id @default(uuid())
  class_history_id String
  class_history ClassHistory @relation(fields: [class_history_id], references: [id])
  arabic_period_id String
  arabic_period ArabicPeriod @relation(fields: [arabic_period_id], references: [id])
  created_at DateTime @default(now())
  @@unique([class_history_id, arabic_period_id])
  @@map("arabic_period_class_histories")
}