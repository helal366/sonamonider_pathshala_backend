// StudentFeeRate and StudentFeePayment
model StudentFeeRate {
  id         String  @id @default(uuid())
  student_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fee_type          StudentFeeType
  billing_frequency BillingFrequency
  amount            Decimal          @db.Decimal(10, 2)
  effective_from    DateTime         @default(now())
  effective_to      DateTime?

  created_by_id String?
  created_by    User?   @relation("student_fee_rate_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("student_fee_rate_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([student_id, fee_type, billing_frequency, effective_from])
  @@index([student_id, fee_type, effective_from])
  @@map("student_fee_rates")
}

model StudentFeePayment {
  id         String  @id @default(uuid())
  student_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fee_type           StudentFeeType
  billing_frequency  BillingFrequency
  billing_period_key String
  amount             Decimal          @db.Decimal(10, 2)
  paid_at            DateTime         @default(now())
  receipt_number     String?          @unique

  created_by_id String?
  created_by    User?   @relation("student_fee_payment_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("student_fee_payment_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([student_id, fee_type, billing_frequency, academic_year_id, billing_period_key])
  @@index([student_id, paid_at])
  @@map("student_fee_payments")
}