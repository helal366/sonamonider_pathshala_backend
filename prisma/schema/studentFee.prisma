// StudentFeeRate and StudentFeePayment
model StudentFeeRate {
  id         String  @id @default(uuid())
  
  class_history_id String
  class_history ClassHistory @relation(fields: [class_history_id], references: [id])
  fee_type          StudentFeeType
  billing_frequency BillingFrequency
  amount            Decimal           @db.Decimal(10, 2)
  discount_amount Decimal          @db.Decimal(10, 2) @default(0)
  amount_to_pay Decimal          @db.Decimal(10, 2)

  created_by_id String?
  created_by    User?   @relation("student_fee_rate_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("student_fee_rate_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([class_history_id, fee_type, billing_frequency])
  @@map("student_fee_rates")
}

model StudentFeePayment {
  id         String  @id @default(uuid())

  class_history_id String
  class_history ClassHistory @relation(fields: [class_history_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fee_type           StudentFeeType
  billing_frequency  BillingFrequency
  billing_period_key String
  amount_to_pay             Decimal          @db.Decimal(10, 2)
  paid_at            DateTime         @default(now())
  receipt_number     String?          @unique
  online_payment_gateway    String?
  online_tran_id String? @unique

  created_by_id String?
  created_by    User?   @relation("student_fee_payment_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("student_fee_payment_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([class_history_id, fee_type, billing_frequency, academic_year_id, billing_period_key])
  @@index([class_history_id, paid_at])
  @@map("student_fee_payments")
}

model StandardStudentFeeRate {
  id String @id @default(uuid())
  
  fee_type           StudentFeeType
  billing_frequency  BillingFrequency 
  amount             Decimal          @db.Decimal(10, 2)
  ic_registration_fee Decimal?          @db.Decimal(10, 2)
  ic_duration_hrs    Decimal?          @db.Decimal(10, 2)
  qc_duration_hrs    Decimal?          @db.Decimal(10, 2)
  
  assigned_classes ClassStandardStudentFeeRate[]

  section Section
  version Version
  department Department?

  created_by_id String?
  created_by    User?   @relation("assigned_student_fee_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("assigned_student_fee_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("standard_student_fee_rates")
}

model ClassStandardStudentFeeRate {
  id String @id @default(uuid())

  class_id String
  class    Class @relation(fields: [class_id], references: [id], onDelete: Cascade)

  standard_student_fee_rate_id String
  standard_student_fee_rate StandardStudentFeeRate @relation(fields: [standard_student_fee_rate_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([class_id, standard_student_fee_rate_id])

  @@map("class_standard_student_fee_rates")
}