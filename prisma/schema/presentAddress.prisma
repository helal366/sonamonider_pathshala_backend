model PresentAddress {
  id            String  @id @default(uuid())
  house_no      String?
  house_name    String?
  plot_no       String?
  road_no       String?
  neighbourhood String?
  region        String?
  village       String?
  post_code     Int?
  post_office   String?
  
  thana         String
  district String
  country  String @default("Bangladesh")

  user_id String? @unique
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  spouse_id String?            @unique
  spouse    SpouseInformation? @relation(fields: [spouse_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_by_id String?
  created_by    User?           @relation("present_address_created_by", fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?           @relation("present_address_updated_by", fields: [updated_by_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("present_addresses")
}
