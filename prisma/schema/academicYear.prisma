model AcademicYear {
  id   String @id @default(uuid())
  year_name String @unique

  class_history ClassHistory[]

  created_by_id String?
  created_by    User?   @relation("academic_year_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("academic_year_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
}
