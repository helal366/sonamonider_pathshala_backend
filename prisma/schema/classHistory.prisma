model ClassHistory {
  id String @id @default(uuid())

  start_date DateTime
  end_date   DateTime?

  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  roll_number Int

  quranic_class_id String?
  quranic_class    QuranicClass? @relation(fields: [quranic_class_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quranic_class_period_id String?
  quranic_class_period QuranicClassPeriod? @relation(fields: [quranic_class_period_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shift_id String
  shift    Shift  @relation(fields: [shift_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  student_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  created_by_id String?
  created_by    User?   @relation("class_history_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("class_history_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

 @@unique([roll_number, class_id, shift_id, academic_year_id], name: "roll_class_shift_year_unique")
  @@index([start_date])
  @@index([end_date])
  @@index([student_id, end_date])
  @@map("class_history")
}

