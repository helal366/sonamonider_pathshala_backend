// ClassHistory and ClassHistoryQuranicPeriod
model ClassHistory {
  id String @id @default(uuid())

  start_date DateTime
  end_date   DateTime?

  student_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  roll_number Int
  shift       Shift
  section     Section
  version     Version

  quranic_subject_id String
  quranic_subject    QuranicSubject @relation(fields: [quranic_subject_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  class_history_quranic_periods ClassHistoryQuranicPeriod[]

  created_by_id String?
  created_by    User?   @relation("class_history_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("class_history_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([roll_number, class_id, shift, academic_year_id, version], name: "roll_class_shift_year_unique", map: "class_history_roll_number_class_id_shift_academic_year_key")
  @@index([start_date])
  @@index([end_date])
  @@index([student_id, end_date])
  @@map("class_history")
}

// Class-history dates represent the academic-year window; end_date is set to the year boundary.
// Readmission locates the previous year's record by student_id and end_date.

model ClassHistoryQuranicPeriod {
  id               String       @id @default(uuid())
  class_history_id String
  class_history    ClassHistory @relation(fields: [class_history_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quranic_period_id String
  quranic_period    QuranicPeriod @relation(fields: [quranic_period_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())

  // Prevents linking the exact same period to the exact same class history row twice
  @@unique([class_history_id, quranic_period_id], name: "history_period_unique")
  @@index([class_history_id])
  @@index([quranic_period_id])
  @@map("class_history_quranic_periods")
}
