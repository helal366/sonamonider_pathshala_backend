model User {
  id String @id @default(uuid())

  full_name                String
  gender                   Gender
  blood_group              BloodGroup?
  date_of_birth            DateTime?
  height_in_cm             Float?
  weight_in_kg             Float?
  religion                 Religion?
  nationality              String      @default("Bangladeshi")
  birth_certificate_number String?
  nid_number               String?
  photo_url                String?

  mobile_number      String
  is_mobile_verified Boolean @default(false)

  email             String  @unique
  is_email_verified Boolean @default(false)

  user_name     String? @unique
  user_password String?

  active_status ActiveStatus @default(ACTIVE)
  is_deleted    Boolean      @default(false)

  promotion_requests PromotionRequest[]

  current_role Role?

  current_position_id String?
  current_position    UserPosition? @relation("user_position_relation", fields: [current_position_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  management_staff_profile ManagementStaff? @relation("management_staff_profile")
  academic_staff_profile   AcademicStaff?   @relation("academic_staff_profile")
  student_profile          Student?         @relation("student_profile")
  governing_body_profile   GoverningBody?   @relation("governing_body_profile")
  
  father_details_id String?
  father_details    FatherDetails? @relation("user_father_details", fields: [father_details_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  mother_details_id String?
  mother_details    MotherDetails? @relation("user_mother_details", fields: [mother_details_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  spouse_information SpouseInformation?

  permanent_address_id String?
  permanent_address PermanentAddress? @relation(fields: [permanent_address_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  present_address_id String?
  present_address   PresentAddress? @relation(fields: [present_address_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_management_staffs ManagementStaff[] @relation("management_staff_created_by")
  updated_management_staffs ManagementStaff[] @relation("management_staff_updated_by")

  created_academic_staffs AcademicStaff[] @relation("academic_staff_created_by")
  updated_academic_staffs AcademicStaff[] @relation("academic_staff_updated_by")

  created_students Student[] @relation("student_created_by")
  updated_students Student[] @relation("student_updated_by")

  created_governing_bodies GoverningBody[] @relation("governing_bodies_created_by")
  updated_governing_bodies GoverningBody[] @relation("governing_bodies_updated_by")

  created_classes Class[] @relation("class_created_by")
  updated_classes Class[] @relation("class_updated_by")

  created_quranic_subjects QuranicSubject[] @relation("quranic_subject_created_by")
  updated_quranic_subjects QuranicSubject[] @relation("quranic_subject_updated_by")

  created_quranic_periods QuranicPeriod[] @relation("quranic_period_created_by")
  updated_quranic_periods QuranicPeriod[] @relation("quranic_period_updated_by")

  created_arabic_subjects ArabicSubject[] @relation("arabic_subject_created_by")
  updated_arabic_subjects ArabicSubject[] @relation("arabic_subject_updated_by")

  created_arabic_periods ArabicPeriod[] @relation("arabic_period_created_by")
  updated_arabic_periods ArabicPeriod[] @relation("arabic_period_updated_by")

  created_subjects GeneralSubject[] @relation("subject_created_by")
  updated_subjects GeneralSubject[] @relation("subject_updated_by")

  created_periods GeneralPeriod[] @relation("period_created_by")
  updated_periods GeneralPeriod[] @relation("period_updated_by")

  created_class_routines ClassRoutine[] @relation("class_routine_created_by")
  updated_class_routines ClassRoutine[] @relation("class_routine_updated_by")

  created_student_result StudentResult[] @relation("student_result_created_by")
  updated_student_result StudentResult[] @relation("student_result_updated_by")

  created_half_yearly_exam_mark HalfYearlyExamMark[] @relation("half_yearly_exam_mark_created_by")
  updated_half_yearly_exam_mark HalfYearlyExamMark[] @relation("half_yearly_exam_mark_updated_by")

  created_annual_exam_mark AnnualExamMark[] @relation("annual_exam_mark_created_by")
  updated_annual_exam_mark AnnualExamMark[] @relation("annual_exam_mark_updated_by")

  created_co_curricular_activities_mark CoCurricularActivitiesMark[] @relation("co_curricular_activities_mark_created_by")
  updated_co_curricular_activities_mark CoCurricularActivitiesMark[] @relation("co_curricular_activities_mark_updated_by")

  created_moral_manners_evaluation_mark MoralMannersEvaluationMark[] @relation("moral_manners_evaluation_mark_created_by")
  updated_moral_manners_evaluation_mark MoralMannersEvaluationMark[] @relation("moral_manners_evaluation_mark_updated_by")

  created_class_history ClassHistory[] @relation("class_history_created_by")
  updated_class_history ClassHistory[] @relation("class_history_updated_by")

  created_monthly_exam_mark MonthlyExamMark[] @relation("monthly_exam_mark_created_by")
  updated_monthly_exam_mark MonthlyExamMark[] @relation("monthly_exam_mark_updated_by")

  created_book_list Booklist[] @relation("book_list_created_by")
  updated_book_list Booklist[] @relation("book_list_updated_by")

  created_promotion_requests PromotionRequest[] @relation("promotion_request_created_by")
  updated_promotion_requests PromotionRequest[] @relation("promotion_request_updated_by")

  created_promotion_history PromotionHistory[] @relation("promotion_history_created_by")
  updated_promotion_history PromotionHistory[] @relation("promotion_history_updated_by")

  created_academic_year AcademicYear[] @relation("academic_year_created_by")
  updated_academic_year AcademicYear[] @relation("academic_year_updated_by")

  audit_logs AuditLog[] @relation("audit_log_changed_by")

  created_academic_result AcademicResult[] @relation("academic_result_created_by")
  updated_academic_result AcademicResult[] @relation("academic_result_updated_by")

  created_father_details FatherDetails[] @relation("father_details_created_by")
  updated_father_details FatherDetails[] @relation("father_details_updated_by")

  created_mother_details MotherDetails[] @relation("mother_details_created_by")
  updated_mother_details MotherDetails[] @relation("mother_details_updated_by")

  created_permanent_addresses PermanentAddress[] @relation("permanent_address_created_by")
  updated_permanent_addresses PermanentAddress[] @relation("permanent_address_updated_by")

  created_present_addresses PresentAddress[] @relation("present_address_created_by")
  updated_present_addresses PresentAddress[] @relation("present_address_updated_by")

  created_spouse_information SpouseInformation[] @relation("spouse_information_created_by")
  updated_spouse_information SpouseInformation[] @relation("spouse_information_updated_by")

  created_users User[] @relation("user_created_by")
  updated_users User[] @relation("user_updated_by")

  created_positions UserPosition[] @relation("user_position_created_by")
  updated_positions UserPosition[] @relation("user_position_updated_by")

  created_roles Role[]
  updated_roles Role[]

  created_student_fee_rates StudentFeeRate[] @relation("student_fee_rate_created_by")
  updated_student_fee_rates StudentFeeRate[] @relation("student_fee_rate_updated_by")

  created_student_fee_payments StudentFeePayment[] @relation("student_fee_payment_created_by")
  updated_student_fee_payments StudentFeePayment[] @relation("student_fee_payment_updated_by")

  created_staff_salary_rates StaffSalaryRate[] @relation("staff_salary_rate_created_by")
  updated_staff_salary_rates StaffSalaryRate[] @relation("staff_salary_rate_updated_by")

  created_staff_payments StaffPayment[] @relation("staff_payment_created_by")
  updated_staff_payments StaffPayment[] @relation("staff_payment_updated_by")


  created_by_id String?
  created_by    User?   @relation("user_created_by", fields: [created_by_id], references: [id])
  updated_by_id String?
  updated_by    User?   @relation("user_updated_by", fields: [updated_by_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([full_name, mobile_number], name: "user_full_name_mobile_unique")
  @@map("users")
}
