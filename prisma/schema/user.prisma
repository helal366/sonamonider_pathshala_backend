model User {
  id        String @id @default(uuid())
  full_name String

  mobile_number      String
  is_mobile_verified Boolean @default(false)

  email             String? @unique
  is_email_verified Boolean @default(false)

  gender                   Gender
  blood_group              BloodGroup?
  date_of_birth            DateTime?
  height_in_cm             Float?
  weight_in_kg             Float?
  religion                 Religion?
  nationality              String      @default("Bangladeshi")
  birth_certificate_number String?
  nid_number               String?
  photo_url                String?

  user_name     String? @unique
  user_password String?

  active_status ActiveStatus @default(ACTIVE)
  is_deleted    Boolean      @default(false)

  role_id String?
  role    UserRole? @relation("user_role_relation", fields: [role_id], references: [role_name], onDelete: Restrict, onUpdate: Cascade)

  position_id String?
  position    UserPosition? @relation("user_position_relation", fields: [position_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  management_staff_profile ManagementStaff?

  father_details_id String?
  father_details    FatherDetails? @relation("user_father_details", fields: [father_details_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  mother_details_id String?
  mother_details    MotherDetails? @relation("user_mother_details", fields: [mother_details_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  permanent_address PermanentAddress?
  present_address   PresentAddress?

  created_by_id String?
  created_by    ManagementStaff? @relation("user_created_by", fields: [created_by_id], references: [id])
  updated_by_id String?
  updated_by    ManagementStaff? @relation("user_updated_by", fields: [updated_by_id], references: [id])

  @@unique([full_name, mobile_number], name: "user_full_name_mobile_unique")
  @@map("users")
}
