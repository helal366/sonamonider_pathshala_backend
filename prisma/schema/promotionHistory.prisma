model PromotionHistory {
  id String @id @default(uuid())

  // Foreign Keys
  management_staff_id String?
  management_staff    ManagementStaff? @relation(fields: [management_staff_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  academic_staff_id String?
  academic_staff    AcademicStaff? @relation(fields: [academic_staff_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  position_id String
  position    UserPosition @relation(fields: [position_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  student_id String?
  student Student? @relation(fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  governing_body_id String?
  governing_body GoverningBody? @relation(fields: [governing_body_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  
  role_id String
  role    UserRole @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Metadata Fields
  start_date DateTime  @default(now())
  end_date   DateTime?

  created_by_id String?
  created_by    User?   @relation("promotion_history_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("promotion_history_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  @@index([management_staff_id])
  @@index([academic_staff_id])
  @@index([position_id])
  @@index([role_id])
  @@map("promotion_histories")
}
