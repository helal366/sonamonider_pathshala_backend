model ClassRoutine {
  id       String    @id @default(uuid())
  students Student[]

  class Class[] @relation("class_routine_classes")

  shift Shift?

  general_period_id String?
  general_period    GeneralPeriod?   @relation(fields: [general_period_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  general_subjects  GeneralSubject[] @relation("class_routine_subjects")

  quranic_period_id String?
  quranic_period    QuranicPeriod?   @relation(fields: [quranic_period_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quranic_subjects  QuranicSubject[] @relation("class_routine_quranic_subjects")

  arabic_period_id String?
  arabic_period    ArabicPeriod?   @relation(fields: [arabic_period_id], references: [id])
  arabic_subjects  ArabicSubject[]

  teachers AcademicStaff[] @relation("class_routine_teachers")

  created_by_id String?
  created_by    User?   @relation("class_routine_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("class_routine_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("class_routines")
}
