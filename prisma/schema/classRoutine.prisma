model ClassRoutine {
  id String @id @default(uuid())

  class Class[] @relation("class_routine_classes")

  shift_id String?
  shift    Shift?  @relation(fields: [shift_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  period_id String?
  period    Period? @relation(fields: [period_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quranic_period_id String?
  quranic_period    QuranicPeriod? @relation(fields: [quranic_period_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  teachers AcademicStaff[] @relation("class_routine_teachers")

  subjects         Subject[]        @relation("class_routine_subjects")

  quranic_subject_id String?
  quranic_subject QuranicSubject? @relation("class_routine_quranic_subjects", fields: [quranic_subject_id], references: [id])

  created_by_id String?
  created_by    User?   @relation("class_routine_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("class_routine_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("class_rotine")
}
